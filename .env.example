APP_NAME="Packaging Development System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# OQ-03: the interface is Indonesian. English stays as the fallback so a key
# that has not been translated yet shows something readable instead of a blank.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# TSD-PDS-003 §14.2 — storage is UTC timestamps; display, working-day arithmetic
# and digests are WIB. config/app.php reads this key (the skeleton default of
# 'UTC' was hardcoded and had to be switched to env()).
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- database
# The app connects as pds_app: schema-scoped DML/DDL only, and after the audit
# tables exist it has no UPDATE/DELETE on audit_entries or access_logs (TSD-1102).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pds
DB_USERNAME=pds_app
DB_PASSWORD=
# PHPUnit runs on pds_test; the schema name is pinned in phpunit.xml so the
# suite can never migrate or truncate pds.

# ---------------------------------------------------------------- session / queue / cache
SESSION_DRIVER=database
# FSD-103: expiry at 30 idle minutes, warned at 25 so MSG-004 can be answered.
SESSION_LIFETIME=30
SESSION_IDLE_WARNING_MINUTES=25
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
# ADR-05 — no Redis on this host. file locally; switch to database if the
# permission cache proves chatty.
CACHE_STORE=file

FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------- mail
# Local development points at Mailpit (127.0.0.1:1025, no credentials, no TLS).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@npd-ppm.my.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- workflow (config/workflow.php)
WORKFLOW_SLA_APPROVER_WORKING_DAYS=3
WORKFLOW_SLA_MANAGER_COPY_WORKING_DAYS=5
WORKFLOW_INVITATION_DEADLINE_DAYS=7
WORKFLOW_DIGEST_CRON="0 8 * * *"
WORKFLOW_ESCALATION_CRON="30 8 * * 1-5"
WORKFLOW_INTEGRITY_CRON="0 23 * * *"

# ---------------------------------------------------------------- numbering (config/numbering.php)
NUMBERING_PREFIX=PPM

# ---------------------------------------------------------------- pdf (config/pdf.php)
PDF_ENGINE=dompdf
PDF_CHROME_PATH=
PDF_CHROME_TIMEOUT=90
PDF_KEEP_DAYS=365

# ---------------------------------------------------------------- uploads (config/upload.php)
UPLOAD_MAX_MB=20
UPLOAD_RETENTION_DAYS=3650

# ---------------------------------------------------------------- access (config/access.php)
# V-101: the exact e-mail domains an account may hold, comma separated with no
# spaces. Enforced when an administrator creates an account and again at the
# login screen. npd-ppm.local is the seeded bootstrap administrator's own
# address; drop it from the list once the directory holds a real one.
PDS_CORPORATE_EMAIL_DOMAINS=npd-ppm.my.id,npd-ppm.local

# ---------------------------------------------------------------- supplier portal
SUPPLIER_PORTAL_URL=http://localhost:8000/supplier
SUPPLIER_TOKEN_TTL_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
